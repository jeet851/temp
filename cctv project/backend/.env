# ============================================
# VisionGuard Backend — Environment Variables
# ============================================

# --- Application ---
APP_NAME=VisionGuard
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./visionguard.db

# --- JWT Authentication ---
JWT_SECRET_KEY=vg-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Media Storage ---
MEDIA_DIR=media

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# ============================================
# Phase 2: OCR Pipeline Configuration
# ============================================

# OCR engine to use: easyocr | tesseract
OCR_ENGINE=easyocr

# Language code for EasyOCR (English)
OCR_LANGUAGE=en

# Set to true if a CUDA GPU is available for faster inference
OCR_GPU=false

# Minimum OCR confidence score (0.0–1.0) to accept a digit reading
OCR_CONFIDENCE_THRESHOLD=0.55

# OCR capture interval for the scheduler (seconds) - 3600s = 1 hour
OCR_CAPTURE_INTERVAL=3600

# -----------------------------------------------
# LCD Region-of-Interest (ROI) Coordinates
# Format: x,y,width,height  (pixel offsets from top-left of the full frame)
#
# These match the simulated CCTV canvas layout in the frontend:
#   - Temperature display block starts at ~x=43, y=58, w=110, h=48
#   - Humidity display block starts at ~x=175, y=58, w=115, h=48
#
# Tune these coordinates to match your real camera frame if connecting live RTSP.
# -----------------------------------------------
OCR_TEMP_ROI=43,58,110,48
OCR_HUM_ROI=175,58,115,48
